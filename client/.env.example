# Set this to the backend's actual PORT (the backend defaults to port 3000).
VITE_API_BASE_URL=http://localhost:3000/api
# Active store tenant ID used for customer registration. Ask the backend team for it.
VITE_TENANT_ID=
# Public Razorpay key ID only. Never put the Razorpay secret in the frontend.
VITE_RAZORPAY_KEY_ID=
