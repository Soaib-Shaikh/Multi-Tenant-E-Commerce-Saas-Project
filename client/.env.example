# Set this to the backend's actual PORT (the backend defaults to port 3000).
VITE_API_BASE_URL=http://localhost:3000/api
# Active store tenant ID used for guest catalog browsing and customer registration.
# Ask the store owner/backend team for the approved store's tenant ID.
VITE_TENANT_ID=
# Public Razorpay key ID only. Never put the Razorpay secret in the frontend.
VITE_RAZORPAY_KEY_ID=
